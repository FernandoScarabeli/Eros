{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eros",
  "version": "0.1.0",
  "identifier": "dev.eros.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Eros",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#111211"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "DeveloperTool",
    "shortDescription": "Workspace local para agentes de código"
  }
}
